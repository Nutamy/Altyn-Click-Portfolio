{
  "name": "altyn-click-portfolio",
  "private": true,
  "scripts": {
    "build": "tailwindcss -i ./src/input.css -o ./dist/styles.css --minify && npm run world && node scripts/build-i18n.mjs",
    "watch": "tailwindcss -i ./src/input.css -o ./dist/styles.css --watch",
    "world": "esbuild src/world/world.js --bundle --format=esm --minify --target=es2020 --legal-comments=none --outfile=dist/world.js",
    "i18n": "node scripts/build-i18n.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "tailwindcss": "^3.4.17",
    "three": "^0.170.0"
  }
}
